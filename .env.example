# ============================================
# KOPIRATI u .env.local i popuniti vrednosti
# ============================================

# URL sajta (bez trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Naziv sajta
NEXT_PUBLIC_SITE_NAME=My Site

# Google Places API
# Dobijate na: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_PLACES_API_KEY=

# Google Place ID vaše firme
# Pronađite na: developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# Google Analytics (opciono)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
